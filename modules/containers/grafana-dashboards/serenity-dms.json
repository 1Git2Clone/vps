{
  "uid": "serenity-dms",
  "title": "serenity \u00b7 DMs",
  "schemaVersion": 41,
  "version": 0,
  "editable": true,
  "tags": [
    "serenity"
  ],
  "time": {
    "from": "now-6d",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "DMs",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" && (span.guild_name = \"DM\" || span.guild_id = \"0\" || span.guild_id = \"None\") && span.author != \"1211325231659089920\" } | count_over_time()",
          "refId": "A",
          "step": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "DMs per hour",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 20,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" && (span.guild_name = \"DM\" || span.guild_id = \"0\" || span.guild_id = \"None\") && span.author != \"1211325231659089920\" } | count_over_time()",
          "refId": "A",
          "step": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
            "barWidthFactor": 0.9,
            "gradientMode": "none",
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Most active users",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" && (span.guild_name = \"DM\" || span.guild_id = \"0\" || span.guild_id = \"None\") && span.author != \"1211325231659089920\" && span.author_name != nil } | count_over_time() by (span.author_name)",
          "refId": "A",
          "step": "1h"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" && (span.guild_name = \"DM\" || span.guild_id = \"0\" || span.guild_id = \"None\") && span.author != \"1211325231659089920\" && span.guild_id =~ \"Some.*\" } | count_over_time() by (span.author)",
          "refId": "B",
          "step": "1h"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "sum"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "User",
              "Total": "DMs"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "DMs",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "User"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Most active users",
                    "url": "/d/serenity-user/serenity-user?var-user=${__value.raw}&var-guild=.*&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "DMs",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Recent DMs",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ (span.guild_name = \"DM\" || span.guild_id = \"0\" || span.guild_id = \"None\") && span.author != \"1211325231659089920\" } | select(span.content, span.author, span.author_name, span.channel_id, span.attachments, span.links)",
          "refId": "A",
          "limit": 100,
          "spss": 5,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "nested": true
            },
            "renameByName": {
              "author_name": "Author",
              "author": "User ID",
              "channel_id": "Channel",
              "attachments": "File count",
              "links": "Links",
              "content": "Message",
              "attachment_urls": "Files",
              "guild_name": "Guild",
              "guild_id": "Guild ID"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Author"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Author",
                    "url": "/d/serenity-user/serenity-user?var-user=${__value.raw}&var-guild=.*&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "User ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open User ID",
                    "url": "/d/serenity-user/serenity-user?var-user=${__value.raw}&var-guild=.*&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Guild"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Guild",
                    "url": "/d/serenity-guild/serenity-guild?var-guild=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Message"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}
