{
  "uid": "serenity-overview",
  "title": "serenity \u00b7 overview",
  "schemaVersion": 41,
  "version": 0,
  "editable": true,
  "tags": [
    "serenity"
  ],
  "time": {
    "from": "now-6d",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Messages",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" } | count_over_time()",
          "refId": "A",
          "step": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Messages per hour",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 20,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" } | count_over_time()",
          "refId": "A",
          "step": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
            "barWidthFactor": 0.9,
            "gradientMode": "none",
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Hot guilds",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" && span.guild_name != nil } | count_over_time() by (span.guild_name)",
          "refId": "A",
          "step": "1h"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" && span.guild_id =~ \"Some.*\" } | count_over_time() by (span.guild_id)",
          "refId": "B",
          "step": "1h"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "sum"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "Guild",
              "Total": "Messages"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Messages",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Guild"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Hot guilds",
                    "url": "/d/serenity-guild/serenity-guild?var-guild=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Guild"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Messages",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Slow traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 10,
        "y": 5,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" && duration > 200ms }",
          "refId": "A",
          "limit": 50,
          "spss": 5
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "nested": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "Recent messages",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" } | select(span.content, span.author, span.author_name, span.channel_id, span.attachments, span.links)",
          "refId": "A",
          "limit": 100,
          "spss": 5,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "nested": true
            },
            "renameByName": {
              "author_name": "Author",
              "author": "User ID",
              "channel_id": "Channel",
              "attachments": "File count",
              "links": "Links",
              "content": "Message",
              "attachment_urls": "Files",
              "guild_name": "Guild",
              "guild_id": "Guild ID"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Author"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Author",
                    "url": "/d/serenity-user/serenity-user?var-user=${__value.raw}&var-guild=.*&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "User ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open User ID",
                    "url": "/d/serenity-user/serenity-user?var-user=${__value.raw}&var-guild=.*&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Guild"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Guild",
                    "url": "/d/serenity-guild/serenity-guild?var-guild=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Message"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "Recent attachments",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"handle_message\" && span.attachments > 0 } | select(span.attachment_urls, span.content, span.author, span.author_name, span.channel_id, span.guild_name)",
          "refId": "A",
          "limit": 100,
          "spss": 5,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "nested": true
            },
            "renameByName": {
              "author_name": "Author",
              "author": "User ID",
              "channel_id": "Channel",
              "attachments": "File count",
              "links": "Links",
              "content": "Message",
              "attachment_urls": "Files",
              "guild_name": "Guild",
              "guild_id": "Guild ID"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Author"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Author",
                    "url": "/d/serenity-user/serenity-user?var-user=${__value.raw}&var-guild=.*&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "User ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open User ID",
                    "url": "/d/serenity-user/serenity-user?var-user=${__value.raw}&var-guild=.*&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Guild"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Guild",
                    "url": "/d/serenity-guild/serenity-guild?var-guild=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Message"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}
