# Copy to terraform.tfvars and fill in. Never commit the real file — it is
# gitignored, alongside .terraform/ and any *.tfstate.

# Hetzner Cloud. Omit to fall back to $HCLOUD_TOKEN.
hcloud_token = "YOUR_HETZNER_CLOUD_API_TOKEN"

# Cloudflare. The token needs Zone:Read + DNS:Edit on this zone only.
#
# This is a DIFFERENT token from cloudflare/api_token in secrets.yaml, and they
# are deliberately separate: this one is used by tofu from a workstation, that
# one by lego on the VPS. Keeping them apart means an IP filter, a scope change
# or a rotation on one cannot silently break the other — which is exactly what
# happened once, when the VPS token was pinned to the old server's address and
# certificate issuance failed from anywhere else.
#
# If you ever add an IP filter, remember there are two tokens and two callers.
cloudflare_api_token = "YOUR_CLOUDFLARE_API_TOKEN"
cloudflare_zone_id   = "YOUR_CLOUDFLARE_ZONE_ID"

# Public key nixos-anywhere installs with. Must be a key you hold the private
# half of on the machine running tofu.
ssh_public_key = "ssh-ed25519 AAAA... you@workstation"

# DKIM public keys. dkim_default_key is the public half of
# email/dkim_private_key in secrets.yaml — publishing one without deploying the
# other means every recipient fails the signature.
dkim_cloudflare_key = "v=DKIM1; h=sha256; k=rsa; p=YOUR_CLOUDFLARE_DKIM_KEY"
dkim_default_key    = "v=DKIM1; p=YOUR_DEFAULT_DKIM_KEY"

# This box's tailscale address, from `tailscale status`. dozzle/grafana/
# syncthing become A records pointing at it. Unroutable from the internet, so
# publishing it exposes nothing; leave it out and those records are not created.
tailnet_ipv4 = "100.101.102.103"

# Get it from Settings -> Account on BlueSky.
bsky_record = "did=did:plc:..."

# === CI runners ===
# One entry per box, in BOTH lists, keyed by the Hetzner server name. Adding a
# runner is two lines here and an apply -- nothing in modules/runner/ is
# per-box, so there is no flake change, no deploy and no commit.
runner_names = ["forgejo-runner"]

# Each runner's Forgejo identity: the uuid and secret shown together exactly
# once at Site Administration -> Actions -> Runners -> Create new runner.
# Delivered to the box as Hetzner user_data, which is per-SERVER -- that is what
# lets N clones of one snapshot come up as N distinct runners with no state.
#
# `forgejo-runner:` is a KEY the boot-time parser searches for, not a name; the
# blob may hold other lines in any order.
#
# Separate from runner_names because OpenTofu refuses to use a sensitive value
# as a for_each argument. CHANGING AN ENTRY REPLACES THAT BOX (hcloud cannot set
# user_data on an existing server) and its public IPv4 changes with it.
runner_identities = {
  "forgejo-runner" = "forgejo-runner: 187cde37-2e9b-4601-b431-b437e7f83bc4 CHANGEME32AlphanumericCharsOrMore"
}

# The same boxes' public IPv4s as /32, for the VPS's egress allow-list -- `ssh
# -J vps root@<runner>` is the only admin path, since the runners are off the
# tailnet. Keep equal to infra.runnerIPv4s in modules/options.nix: the cloud
# firewall and the VPS's nftables are each what survives a misconfiguration of
# the other, so a rule in one alone is not sufficient.
runner_ipv4s = ["46.225.61.172/32"]

# Optional overrides:
# domain      = "hu-tao.dev"
# server_name = "hu-tao"
# server_type = "cx22"
# location    = "fsn1"
